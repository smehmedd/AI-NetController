    "lint": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx apps/web/src/tests/verifyPillars.ts && tsx apps/web/src/tests/stressTest.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
