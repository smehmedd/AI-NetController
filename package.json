    "d3": "^7.9.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4",
    "tsx": "^4.23.15",
    "vite": "^6.4.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
