  "version": "1.0.0",
  "description": "Autonomous LAN PC Inspector, Fleet Manager & Agentic OS Bridge",
  "type": "module",
  "scripts": {
    "dev": "tsx apps/web/server.ts",
    "start": "tsx apps/web/server.ts",
    "build": "vite build --config apps/web/vite.config.ts apps/web",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('apps/web/dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx apps/web/src/tests/verifyPillars.ts && tsx apps/web/src/tests/stressTest.ts"
  },
  "dependencies": {
    "@google/genai": "^0.2.1",
